# JWT Secret Key
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-change-this-in-production

# Public Square IP hash salt — mixed into visitor IPs before hashing for
# anonymous vote/spam dedup. Raw IPs are never stored.
# Generate with: openssl rand -hex 32
IP_HASH_SALT=your-salt-here-change-this-in-production

# CORS Origins (comma-separated list of allowed origins)
# Add your GitHub Pages frontend URL
CORS_ORIGINS=https://yourusername.github.io,http://localhost:3000

# Host directory that holds public-gallery/, videos/, and recipe-photos/ (optional, default /mnt/ssd)
# MEDIA_ROOT=/mnt/ssd

# Host directory that holds the sqlite database file (optional, default /mnt/ssd/db)
# DB_DIR=/mnt/ssd/db

# Display kiosk remote control -- shared secret the surfcam agent on displaytop
# sends to pick up remote presses from the admin page. Same value goes in
# ~/surfcam-agent/kiosk-token on displaytop. Leave empty to turn it off.
# Generate with: openssl rand -hex 32
KIOSK_TOKEN=

# Kiln logger shared secret (X-Kiln-Token). Empty turns off storing readings. Generate with: openssl rand -hex 32
KILN_TOKEN=
# Where to get the outdoor forecast for the kiln's cooldown. Keep it city-level, it goes to an outside service
KILN_WEATHER_LATITUDE=32.8
KILN_WEATHER_LONGITUDE=-117.2
