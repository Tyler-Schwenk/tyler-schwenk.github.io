# password butt uses to send the stream (the "Password" field in butt's server settings).
# hex only. generate with: openssl rand -hex 16
ICECAST_SOURCE_PASSWORD=

# password for icecast's admin pages at http://192.168.1.116:8010/admin/ (user: admin).
# hex only. generate with: openssl rand -hex 16
ICECAST_ADMIN_PASSWORD=

# guest djs, each with their own mount and password: space separated mount:password pairs,
# like "tracepoint:<hex>". the mount is what goes in their butt (and in their guest login,
# scripts/create_dj_guest.py), the password their butt's password. hex only, generate each
# with: openssl rand -hex 16. leave empty for no guests
ICECAST_GUEST_MOUNTS=
