<!--
  icecast config for the live dj stream. entrypoint.sh fills in the passwords.
  the only listeners are the website backend (its recorder, its live meter, and its
  public relay at /dj/live), so the limits are small. tyler streams to /live with the
  global source password; each guest dj gets their own mount and password, which
  entrypoint.sh writes in from ICECAST_GUEST_MOUNTS. see pi/docs/services/dj-stream.md
-->
<icecast>
    <location>fart-pi</location>
    <admin>admin@localhost</admin>

    <limits>
        <!-- the backend's recorder and live meter, plus its relay, which caps listeners itself -->
        <clients>40</clients>
        <!-- one dj on air at a time. a second butt gets "too many sources connected"
             and keeps retrying, so it goes on as soon as the first one's done -->
        <sources>1</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <!-- how long a silent source connection hangs on before the mount closes -->
        <source-timeout>10</source-timeout>
        <!-- new listeners get a few seconds of audio up front so playback starts right away -->
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <source-password>__SOURCE_PASSWORD__</source-password>
        <admin-user>admin</admin-user>
        <admin-password>__ADMIN_PASSWORD__</admin-password>
    </authentication>

    <!-- a mount per guest dj: only their password works on it, and the global source
         password doesn't. filled in by entrypoint.sh, empty with no guests -->
__GUEST_MOUNTS__

    <hostname>localhost</hostname>

    <listen-socket>
        <port>8000</port>
    </listen-socket>

    <fileserve>1</fileserve>

    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <!-- 3 is info: source connects and disconnects show up -->
        <loglevel>3</loglevel>
        <logsize>10000</logsize>
    </logging>

    <security>
        <chroot>0</chroot>
    </security>
</icecast>
